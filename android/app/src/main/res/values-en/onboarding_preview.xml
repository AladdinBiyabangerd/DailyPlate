    <string name="dp_help_active">In addition to daily activities, 30–50 minutes of such walking, 45 minutes moderate cycling and 40 minutes doubles tennis.</string>
    <string name="dp_help_very_active">In addition to daily activities, 45 minutes moderate cycling, 25 minutes running at 10 km/h and 60 minutes doubles tennis.</string>
